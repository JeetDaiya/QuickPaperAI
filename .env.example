# QuickPaper AI — Server & Client Environment Variables
# Copy this file to .env before starting the application

# LLM Providers & Ingestion
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# Supabase PostgreSQL & Service Role Key
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DB_URI=postgresql://postgres:password@host:6543/postgres

# JWT Secret & Base URLs
SECRET_KEY=your_random_secret_key
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Mail & Redis Services
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=ai.quick.paper@gmail.com
SMTP_SERVER=smtp-relay.brevo.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Firebase Admin (Backend) & Web Push Credentials (Frontend)
FIREBASE_CREDENTIALS=firebase-credentials.json
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_VAPID_PUBLIC_KEY=your_firebase_vapid_public_key
