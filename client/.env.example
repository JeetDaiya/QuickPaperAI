# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.

# Backend base URL — the FastAPI app in ../QuickPaperAI.
# Required for any production build: with this unset, the built app throws on load
# instead of silently calling localhost. `npm run dev` falls back to
# http://localhost:8000 with a console warning.
VITE_API_BASE_URL=http://localhost:8000

# Dev server port. Must be one of 5173 / 8080 / 3000 / 8000 — the backend's dev CORS
# allowlist rejects anything else. The port is pinned (strictPort), so if it's already
# taken Vite errors out rather than silently hopping to 5174 and breaking every request.
VITE_DEV_PORT=8080

# --- Firebase / FCM push ---
# Not read by any code in this client yet — the FCM registration + service worker were
# never ported from the old client (see docs/DEPLOYMENT.md "Known gap"). Only needed if
# that flow gets ported.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_PUBLIC_KEY=
